{{!
    @template core_courseformat/local/content/cm

    Displays a course module instance inside a course section.

    Example context (json):
    {
        "cmname": {
            "displayvalue" : "<a class=\"aalink\" href=\"#\"><span class=\"instancename\">Activity example</span></a>"
        },
        "hasname": "true",
        "afterlink": "<span class=\"badge bg-primary\">30 unread messages</span>",
        "hasextras": true,
        "extras": ["<span class=\"badge bg-secondary\">[extras]</span>"],
        "activityinfo": {
            "hasmodavailability": true,
            "activityname": "Activity example",
            "hascompletion": true,
            "uservisible": true,
            "hasdates": true,
            "isautomatic": true,
            "istrackeduser": true,
            "activitydates": [
                {
                    "label": "Opens:",
                    "datestring": "6 April 2021, 6:46 PM"
                }
            ],
            "completiondetails": [
                {
                    "statuscomplete": 1,
                    "description": "Viewed"
                },
                {
                    "statusincomplete": 1,
                    "description": "Receive a grade"
                }
            ]
        },
        "modstealth": true,
        "indent": 1
    }
}}
{{< core_courseformat/local/content/cm}}

    {{! Mod Label specific edit link. }}
    {{$ core_courseformat/local/content/cm/activity}}
        {{> core_courseformat/local/content/cm/activity}}
        {{#editlabelcontent}}
            <div data-region="label-inline-editor" data-cmid="{{cmid}}">
                <a href="#label-content-form-{{cmid}}" class="btn btn-outline-primary btn-sm"
                    data-action="edit-label-content" aria-controls="label-content-form-{{cmid}}"
                    aria-expanded="false">
                    <i class="fa-solid fa-pen-to-square me-2" aria-hidden="true"></i>
                    {{#str}} editlabelcontent, format_ucl {{/str}}
                </a>
                <div id="label-content-form-{{cmid}}" class="ucl-inline-editor d-none" data-region="label-form"></div>
            </div>
        {{/editlabelcontent}}
    {{/ core_courseformat/local/content/cm/activity}}

    {{! Add content controls. }}
    {{$content}}
        <a role="button" href="{{{labelurl}}}" class="btn btn-add-content me-3">
            <i class="fa-solid fa-circle-plus me-2"></i>
            {{#str}}addtextmedia, format_ucl{{/str}}
        </a>
        <button
                class="btn btn-add-content section-modchooser section-modchooser-link"
                data-action="open-chooser"
                data-sectionnum="{{sectionnum}}"
                data-beforemod="{{cmid}}"
                data-sectionreturnnum="{{sectionnum}}"
        >
            <i class="fa-solid fa-file-circle-plus me-2"></i>
            {{#str}}addactivity, format_ucl{{/str}}
        </button>
    {{/content}}
{{/ core_courseformat/local/content/cm}}
