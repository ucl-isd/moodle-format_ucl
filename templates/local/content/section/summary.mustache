{{!
    @template format_ucl/local/content/section/summary

    Displays a course section summary and inline edit controls.

    Example context (json):
    {
        "id": 12,
        "hassummary": true,
        "isediting": true,
        "summary": {
            "summarytext": "Section description"
        }
    }
}}
<div class="ucl-section-summary" data-region="ucl-section-summary" data-sectionid="{{id}}"
    data-has-summary="{{#hassummary}}true{{/hassummary}}{{^hassummary}}false{{/hassummary}}">
    <div data-region="summary-display" {{^hassummary}}class="d-none"{{/hassummary}}>
        {{#hassummary}}
            {{> core_courseformat/local/content/section/summary }}
        {{/hassummary}}
    </div>

    {{#isediting}}
        <a href="#section-summary-form-{{id}}" class="btn btn-outline-primary btn-sm" data-action="edit-section-summary"
            data-add-label="{{#str}} addsectiondescription, format_ucl {{/str}}"
            data-edit-label="{{#str}} editsectiondescription, format_ucl {{/str}}"
            aria-controls="section-summary-form-{{id}}" aria-expanded="false">
            <i class="fa-solid fa-pen-to-square me-2" aria-hidden="true"></i>
            <span data-region="summary-action-label">
                {{#hassummary}}{{#str}} editsectiondescription, format_ucl {{/str}}{{/hassummary}}
                {{^hassummary}}{{#str}} addsectiondescription, format_ucl {{/str}}{{/hassummary}}
            </span>
        </a>
        <div id="section-summary-form-{{id}}" data-region="summary-form"></div>
    {{/isediting}}
</div>

{{#isediting}}
    {{#js}}
        require(['format_ucl/local/sectiondescription'], function(component) {
            component.init();
        });
    {{/js}}
{{/isediting}}
