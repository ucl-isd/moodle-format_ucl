{{!
    @template format_ucl/widgets/contacts/contact
    Contact template for displaying individual course contacts.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    * attributes Array of name / value pairs.
    Example context (json):
    {
        "id": 1,
        "contactid": 10,
        "domid": "user-1",
        "name": "John Doe",
        "custom": false,
        "picture": "<img src='path/to/picture.jpg' alt='John Doe' class='userpicture'>",
        "url": "/user/view.php?id=1",
        "role": "Course teacher",
        "description": "Course lead and primary contact.",
        "caneditprofile": true,
        "editurl": "/user/editadvanced.php?id=1",
        "email": "john.doe@example.com",
        "subject": "Course%201",
        "show": true,
        "isediting": true,
        "customcontactform": {
            "formhtml": "<form>...</form>"
        }
    }
}}

{{! Contact. }}
<div class="ucl-format-coursecontact-wrapper col-md-4 col-sm-6 mb-2 position-relative" data-userid="{{id}}">
    {{! Contact button. }}
    <button class="btn btn-link ucl-format-contact-trigger d-flex text-left"
    type="button" popovertarget="popover-{{domid}}" style="anchor-name: --contact-{{domid}};">

        {{! Image. }}
        <span class="ucl-format-coursecontact-picture mr-2">
            {{{picture}}}

            {{^custom}}
            <span
                class="ucl-format-image-hidden rounded-circle bg-warning d-flex align-items-center justify-content-center"
                title="{{#str}}hiddenfromstudents, format_ucl{{/str}}"
            >
                <i class="fa-regular fa-solid fa-eye-slash text-dark"></i>
            </span>
            {{/custom}}

            {{! Custom contact image.}}
            {{#custom}}
            <span class="userinitials">
                <i class="fa-regular fa-envelope fa-lg"></i>
            </span>
            {{/custom}}
        </span>

        {{! Data. }}
        <span>
            <span class="ucl-format-contact-name d-block">
                {{{name}}}
            </span>
            {{#role}}
                <span class="small text-muted">
                    {{{.}}}
                </span>
            {{/role}}
        </span>
    </button>

    {{! Editing. }}
    {{#isediting}}
        <div class="pl-3 pb-3 border-bottom">
            {{^custom}}
                <div class="custom-control custom-switch">
                    <input type="checkbox" id="switch-{{id}}"
                        class="contact-hide-toggle custom-control-input"
                        data-userid="{{id}}"
                        data-action="{{#show}}hide{{/show}}{{^show}}show{{/show}}"
                        {{#show}} checked {{/show}}
                    >
                    <label class="custom-control-label" for="switch-{{id}}">
                        <small>{{#str}} showtostudents, format_ucl, {{{name}}}{{/str}}</small>
                    </label>
                </div>
            {{/custom}}

            {{#custom}}
                <div>
                    <a href="#ucl-format-customcontact-form-{{contactid}}"
                        role="button"
                        class="btn btn-sm text-nowrap btn-add-content"
                        data-toggle="collapse"
                        aria-expanded="false"
                        aria-controls="ucl-format-customcontact-form-{{contactid}}"
                    >
                        <i class="fa-regular fa-circle-user mr-2"></i>
                        {{#str}} editcustomcontact, format_ucl {{/str}}
                        <span class="sr-only">{{{name}}}</span>
                    </a>
                </div>
            {{/custom}}
        </div>
    {{/isediting}}

    {{! Popover Card. }}
    <div id="popover-{{domid}}" class="ucl-format-contact-popover position-absolute p-3 mx-1 ucl-box-shadow animate-down scalein-up"
    popover="auto"  style="position-anchor: --contact-{{domid}};">

        {{! Contact. }}
        <div class="d-flex">
            {{#picture}}
                <div class="mr-2">
                    {{{.}}}
                </div>
            {{/picture}}

            <div>
                {{#url}}
                    <a href="{{{url}}}">{{{name}}}</a>
                {{/url}}

                {{#custom}}
                    {{{name}}}
                {{/custom}}

                {{#role}}
                    <div class="small text-muted">
                        {{{.}}}
                    </div>
                {{/role}}
            </div>
        </div>

        {{! Description. }}
        {{#description}}
            <div class="small mt-2 pt-3 border-top">{{{.}}}</div>
        {{/description}}

        {{^custom}}
            {{#caneditprofile}}
                <div class="py-3 border-top">
                    <a href="{{{editurl}}}" target="_blank" class="btn btn-sm btn-add-content btn-block">
                        <i class="fa-solid fa-circle-plus mr-2"></i>
                        {{#str}} adddescription, format_ucl{{/str}}
                        <span class="sr-only">{{#str}} forcontact, format_ucl, {{{name}}}{{/str}}</span>
                    </a>
                </div>
            {{/caneditprofile}}
        {{/custom}}

        {{! Email. }}
        {{#email}}
            <div class="mt-2 py-2 border-top">
                <div class="small text-muted">{{#str}} email {{/str}}</div>
                <a href="mailto:{{{email}}}?subject={{{subject}}}" target="_blank" class="text-break">
                    {{{email}}}
                </a>
            </div>
        {{/email}}
    </div>
</div>

{{#isediting}}
    {{#custom}}
        {{> format_ucl/widgets/contacts/customcontact_form }}
    {{/custom}}
{{/isediting}}
