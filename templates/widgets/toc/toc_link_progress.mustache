{{!
    @template format_ucl/widgets/toc/toc_link_progress
    Progress indicator for a TOC. Can be updated with JS.
    Classes required for JS:
    * .pie
    * .sr-only
    Data attributes required for JS:
    * data-id on .progress-indicator
    Context variables required for this template:
    * id Section id.
    * total Number of completable activities in section.
    * complete Number of completed activities in section.
    * percentage Completion percentage.
    * done Whether the section is fully complete.
    Example context (json):
    {
        "id": 42,
        "total": 10,
        "complete": 7,
        "percentage": 70,
        "done": true
    }
}}
<div class="progress-indicator ml-auto" style="max-height: 36px;" data-id="{{id}}">
    {{#total}}
    <div class="pie animate {{#done}} complete {{/done}}"
        style="--p:{{percentage}};--c:green"
        data-toggle="tooltip" data-placement="right"
        title='{{#str}} xofycomplete, format_ucl, { "complete" : "{{complete}}", "total": "{{total}}" } {{/str}}'
        aria-hidden="true"
        data-behat-percentage="{{percentage}}">
            <i class="fa-solid fa-check fa-xs text-white"></i>
    </div>

    <span class="sr-only">
    {{#str}} xofycomplete, format_ucl, { "complete" : "{{complete}}", "total": "{{total}}" } {{/str}}
    </span>
    {{/total}}
</div>
