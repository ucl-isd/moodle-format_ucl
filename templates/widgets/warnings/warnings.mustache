{{!
    @template format_ucl/widgets/warnings/warnings
    Template purpose and description.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    * attributes Array of name / value pairs.
    Example context (json):
    {
        "toc": [
            {
                "showwarning": true,
                "showguidance": true,
                "linktoguidance": "https://example.com/guidance",
                "shownocourseimg": true,
                "url": "https://example.com/course/edit.php?id=2#fitem_id_overviewfiles_filemanager",
                "shownunnamedsections": true,
                "namecount": 2,
                "showtoomanysections": true,
                "visiblecount": 17,
                "recommendedmaxsections": "<span class=\"behat-sectioncount\">4</span>",
                "showtoofewmods": true,
                "modcount": 3
            }
        ]
    }
}}
{{#toc}}
{{#showwarning}}
<div class="d-none d-lg-block p-3 bg-primary-light behat-ucl-tips">
    <div class="behat-linktoguidance">
        <span class="badge text-bg-warning rounded-pill me-1">
            <i class="fa-solid fa-heart-circle-exclamation text-danger me-1"></i>
            {{#str}}editortips, format_ucl{{/str}}
        </span>
        {{#str}}linktoguidance, format_ucl, {{linktoguidance}}{{/str}}
    </div>

    <div class="row small pt-3">
        {{#shownocourseimg}}
            <div class="col-md p-1 behat-nocourseimg">
                <div class="bg-white p-2">
                    <b>{{#str}}nocourseimg, format_ucl{{/str}}</b>
                    <div>{{#str}}nocourseimg:desc, format_ucl, {{url}}{{/str}}</div>
                </div>
            </div>
        {{/shownocourseimg}}

        {{#shownunnamedsections}}
            <div class="col-md p-1 behat-unnamedsections">
                <div class="bg-white p-2">
                    <b><span class="behat-namecount">{{namecount}}</span> {{#str}}unnamedsections, format_ucl{{/str}}</b>
                    <div>{{#str}}unnamedsections:desc, format_ucl{{/str}}</div>
                </div>
            </div>
        {{/shownunnamedsections}}

        {{#showtoomanysections}}
            <div class="col-md p-1 behat-toomanysections">
                <div class="bg-white p-2">
                    <b>{{#str}}toomanysections, format_ucl, {{visiblecount}}{{/str}}</b>
                    <div>{{#str}}toomanysections:desc, format_ucl, {{{recommendedmaxsections}}}{{/str}}</div>
                </div>
            </div>
        {{/showtoomanysections}}

        {{#showtoofewmods}}
            <div class="col-md p-1 behat-toofewmods">
                <div class="bg-white p-2">
                    <b><span class="behat-modcount">{{modcount}}</span> {{#str}}toofewmods, format_ucl{{/str}}</b>
                    <div>{{#str}}toofewmods:desc, format_ucl{{/str}}</div>
                </div>
            </div>
        {{/showtoofewmods}}
    </div>
</div>
{{/showwarning}}
{{/toc}}
