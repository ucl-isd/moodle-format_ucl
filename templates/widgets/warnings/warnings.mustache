{{!
    @template format_ucl/widgets/warnings/warnings
    Template purpose and description.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    * attributes Array of name / value pairs.
    Example context (json):
    {
    }
}}
{{#toc}}
{{#showwarning}}
<div class="d-none d-lg-block px-3 behat-ucl-tips">
    <p><span class="badge text-bg-warning rounded-pill">Tips</span> {{#str}}linktoguidance, format_ucl, {{linktoguidance}}{{/str}}</p>
    <div class="row small">
    {{#shownocourseimg}}
        <div class="col-md-4 py-1 alert alert-info behat-nocourseimg">
            <b>{{#str}}nocourseimg, format_ucl{{/str}}</b>
            <div>{{#str}}nocourseimg:desc, format_ucl, {{url}}{{/str}}</div>
        </div>
    {{/shownocourseimg}}

    {{#shownunnamedsections}}
        <div class="col-md-4 py-1 alert alert-info behat-unnamedsections">
            <b><span class="behat-namecount">{{namecount}}</span> {{#str}}unnamedsections, format_ucl{{/str}}</b>
            <div>{{#str}}unnamedsections:desc, format_ucl{{/str}}</div>
        </div>
    {{/shownunnamedsections}}

    {{#showtoomanysections}}
        <div class="col-md-4 py-1 alert alert-info behat-toomanysections">
            <b>{{#str}}toomanysections, format_ucl, {{visiblecount}}{{/str}}</b>
            <div>{{#str}}toomanysections:desc, format_ucl, {{{recommendedmaxsections}}}{{/str}}</div>
        </div>
    {{/showtoomanysections}}

    {{#showtoofewmods}}
        <div class="col-md-4 py-1 alert alert-info behat-toofewmods">
            <b><span class="behat-modcount">{{modcount}}</span> {{#str}}toofewmods, format_ucl{{/str}}</b>
            <div>{{#str}}toofewmods:desc, format_ucl{{/str}}</div>
        </div>
    {{/showtoofewmods}}

    </div>
</div>
{{/showwarning}}
{{/toc}}
